{"status":{},"spec":{"name":"cr-generate-report","description":"Generate a Prism Central report using NCM Self Service and v4 REST APIs.","resources":{"runbook":{"name":"6e484160_runbook","description":"","task_definition_list":[{"type":"DAG","name":"7537d93d_dag","description":"","attrs":{"type":"","edges":[]},"child_tasks_local_reference_list":[{"name":"Get Report Config","kind":"app_task"}],"variable_list":[],"timeout_secs":"0","retries":"0","inherit_target":false,"status_map_list":[]},{"type":"DECISION","name":"Get Report Config","description":"","attrs":{"type":"","script":"# import required libraries\nimport requests\nimport urllib3\nimport sys\n\n# assign variables defined in the runbook\nusername = \"@@{Prism Central Admin.username}@@\"\npassword = \"@@{Prism Central Admin.secret}@@\"\npc_ip = \"@@{PC_IP}@@\"\n\n# consider the security implications of doing this in production\nurllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)\n\n# get a list of matching Nutanix IAM roles\nresponse = requests.get(f\"https:\/\/{pc_ip}:9440\/api\/opsmgmt\/v4.0\/config\/report-configs?$filter=name eq '@@{REPORT_CONFIG_NAME}@@'\", auth=(f\"{username}\", f\"{password}\"), verify=False)\n\n# make sure at least 1 role was returned\nif len(response.json()[\"data\"]) > 0:\n    exit(0)\nelse:\n    exit(1)","script_type":"python_remote","command_line_args":"","exit_status":[],"login_credential_local_reference":{"name":"Python Endpoint Credentials","kind":"app_credential"},"success_child_reference":{"name":"5d32e244_SUCCESS_META","kind":"app_task"},"failure_child_reference":{"name":"7db92856_FAILURE_META","kind":"app_task"}},"child_tasks_local_reference_list":[],"variable_list":[],"target_any_local_reference":{"name":"python-endpoint-02","kind":"app_endpoint"},"timeout_secs":"0","retries":"0","inherit_target":false,"status_map_list":[]},{"type":"META","name":"5d32e244_SUCCESS_META","description":"","attrs":{"type":""},"child_tasks_local_reference_list":[{"name":"Get Report Config ext_id","kind":"app_task"},{"name":"Generate Request ID","kind":"app_task"},{"name":"Convert Dates","kind":"app_task"},{"name":"Generate Report","kind":"app_task"}],"variable_list":[],"timeout_secs":"0","retries":"0","inherit_target":false,"status_map_list":[]},{"type":"HTTP","name":"Get Report Config ext_id","description":"","attrs":{"type":"","method":"GET","connection_timeout":120,"headers":[],"url":"","request_body":"","content_type":"application\/json","expected_response_params":[{"type":"","status":"SUCCESS","code_range_list":[{"start_code":200,"end_code":200}]},{"type":"","status":"FAILURE","code_range_list":[{"start_code":400,"end_code":400}]},{"type":"","status":"FAILURE","code_range_list":[{"start_code":409,"end_code":409}]}],"authentication":{"type":"none"},"response_paths":{"REPORT_CONFIG_EXTID":"$.data[0].extId"},"tls_verify":false,"proxy_type":"","retry_count":1,"retry_interval":10,"internal_service":"","internal_service_method":"","relative_url":"\/config\/report-configs?$filter=name%20eq%20'@@{REPORT_CONFIG_NAME}@@'"},"child_tasks_local_reference_list":[],"variable_list":[],"target_any_local_reference":{"name":"prism_central_opsmgmt","kind":"app_endpoint"},"timeout_secs":"0","retries":"0","inherit_target":false,"status_map_list":[]},{"type":"SET_VARIABLE","name":"Generate Request ID","description":"","attrs":{"type":"","script":"# import uuid library required to generate UUIDs\nimport uuid\n\n# generate a single new UUID\nrequest_id = uuid.uuid1()\n\n# return the UUID using the method required by NCM Self-Service's \"Set Variable\" task type\nprint(f\"REQUEST_ID={request_id}\")","script_type":"python_remote","exit_status":[],"eval_scope":"local","eval_variables":["REQUEST_ID"]},"child_tasks_local_reference_list":[],"variable_list":[],"timeout_secs":"0","retries":"0","inherit_target":true,"status_map_list":[]},{"type":"SET_VARIABLE","name":"Convert Dates","description":"","attrs":{"type":"","script":"# import datetime library for date\/time conversion\nfrom datetime import datetime\n\n# debug output i.e. show the start and end dates entered by the user\nprint(f\"Formatting start date: @@{REPORT_START}@@\")\nprint(f\"Formatting end date: @@{REPORT_END}@@\")\n\n# convert the report start time\nstart_date_time = \"@@{REPORT_START}@@\"\nstart_object = datetime.strptime(start_date_time, \"%d\/%m\/%Y - %H:%M:%S\")\niso8601_start_date_time = start_object.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n# convert the report end time\nend_date_time = \"@@{REPORT_END}@@\"\nend_object = datetime.strptime(end_date_time, \"%d\/%m\/%Y - %H:%M:%S\")\niso8601_end_date_time = end_object.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n# debug output i.e. show the start and end dates after conversion\nprint(f\"Returning start date in ISO-8601 format: {iso8601_start_date_time}\")\nprint(f\"Returning end date in ISO-8601 format: {iso8601_end_date_time}\")\n\n# return the formatted dates using the method required by NCM Self-Service's \"Set Variable\" task type\nprint(f\"REPORT_START_ISO8601={iso8601_start_date_time}\")\nprint(f\"REPORT_END_ISO8601={iso8601_end_date_time}\")","script_type":"python_remote","exit_status":[],"eval_scope":"local","eval_variables":["REPORT_START_ISO8601","REPORT_END_ISO8601"]},"child_tasks_local_reference_list":[],"variable_list":[],"timeout_secs":"0","retries":"0","inherit_target":true,"status_map_list":[]},{"type":"HTTP","name":"Generate Report","description":"","attrs":{"type":"","method":"POST","connection_timeout":120,"headers":[{"type":"LOCAL","name":"NTNX-REQUEST-ID","description":"","regex":{},"options":{},"is_hidden":false,"is_mandatory":false,"data_type":"BASE","val_type":"STRING","label":"","attrs":{"type":""},"state":"NOT_VALIDATED","message_list":[],"editables":{},"value":"@@{REQUEST_ID}@@"}],"url":"","request_body":"{\n    \"name\": \"@@{REPORT_NAME}@@\",\n    \"configExtId\": \"@@{REPORT_CONFIG_EXTID}@@\",\n    \"isPersistent\": false,\n    \"startTime\": \"@@{REPORT_START_ISO8601}@@\",\n    \"endTime\": \"@@{REPORT_END_ISO8601}@@\",\n    \"recipientFormats\": [\n        \"PDF\"\n    ],\n    \"recipients\": [\n        {\n            \"emailAddress\": \"@@{RECIPIENT_EMAIL}@@\",\n            \"recipientName\": \"@@{RECIPIENT_NAME}@@\"\n        }\n    ]\n}","content_type":"application\/json","expected_response_params":[{"type":"","status":"SUCCESS","code_range_list":[{"start_code":200,"end_code":200}]},{"type":"","status":"FAILURE","code_range_list":[{"start_code":400,"end_code":400}]}],"authentication":{"type":"none"},"response_paths":{},"tls_verify":false,"proxy_type":"","retry_count":1,"retry_interval":10,"internal_service":"","internal_service_method":"","relative_url":"\/config\/reports"},"child_tasks_local_reference_list":[],"variable_list":[],"target_any_local_reference":{"name":"prism_central_opsmgmt","kind":"app_endpoint"},"timeout_secs":"0","retries":"0","inherit_target":false,"status_map_list":[]},{"type":"META","name":"7db92856_FAILURE_META","description":"","attrs":{"type":""},"child_tasks_local_reference_list":[{"name":"Report Config not found","kind":"app_task"}],"variable_list":[],"timeout_secs":"0","retries":"0","inherit_target":false,"status_map_list":[]},{"type":"EXEC","name":"Report Config not found","description":"","attrs":{"type":"","script":"# show an error if no matching Nutanix IAM role was found\n# in production, appropriate error handling would happen here\n# e.g. sending an email alert\nprint(\"No report config was found matching the name \\\"@@{REPORT_CONFIG_NAME}@@\\\".\")","script_type":"python_remote","command_line_args":"","exit_status":[],"login_credential_local_reference":{"name":"Python Endpoint Credentials","kind":"app_credential"}},"child_tasks_local_reference_list":[],"variable_list":[],"timeout_secs":"0","retries":"0","inherit_target":true,"status_map_list":[]}],"main_task_local_reference":{"name":"7537d93d_dag","kind":"app_task"},"variable_list":[{"type":"LOCAL","name":"REPORT_NAME","description":"The name of the generated rep